n = int(input("Enter number of elements: "))

a = list(map(int, input("Enter array elements: ").split()))

k = int(input("Enter k: "))

# Selection Sort
for i in range(n - 1):
    min_index = i
    for j in range(i + 1, n):
        if a[j] < a[min_index]:
            min_index = j
    a[i], a[min_index] = a[min_index], a[i]

print(f"{k}rd Smallest Element =", a[k - 1])
