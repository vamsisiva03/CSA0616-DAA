n = int(input("Enter number of elements: "))

a = list(map(int, input("Elements: ").split()))

comparisons = 0
swaps = 0
# Selection Sort
for i in range(n - 1):
    min_index = i
    for j in range(i + 1, n):
        comparisons += 1
        if a[j] < a[min_index]:
            min_index = j
    if min_index != i:
        a[i], a[min_index] = a[min_index], a[i]
        swaps += 1

print("Sorted Array:", *a)
print("Comparisons:", comparisons)
print("Swaps:", swaps)
